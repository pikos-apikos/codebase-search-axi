#!/usr/bin/env python3
"""Bounded, read-only codebase discovery and search for agents."""

from __future__ import annotations

import argparse
import json
import signal
import sys
from pathlib import Path
from typing import Any

from codebase_search import results
from codebase_search.backend import RgBackend, RgError

DEFAULT_LIMIT = 50
SAFE_GLOBS = [
    "!**/.git/**",
    "!**/node_modules/**",
    "!**/vendor/**",
    "!**/build/**",
    "!**/dist/**",
    "!**/target/**",
    "!**/coverage/**",
    "!**/.venv/**",
    "!**/venv/**",
    "!**/__pycache__/**",
    "!**/.env*",
    "!**/*.pem",
    "!**/*.key",
    "!**/*.crt",
    "!**/*.cer",
    "!**/*.p12",
    "!**/*.pfx",
    "!**/id_rsa*",
]


class JsonParser(argparse.ArgumentParser):
    def error(self, message: str) -> None:
        emit({"status": "error", "error": "invalid_command", "message": message})
        raise SystemExit(2)


def emit(record: dict[str, Any], code: int = 0) -> int:
    print(json.dumps(record, ensure_ascii=False, separators=(",", ":")))
    return code


def common(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--root", default=".", help="repository root (default: current directory)")
    parser.add_argument(
        "--max-results", type=int, help=f"output limit (default: {DEFAULT_LIMIT})"
    )
    parser.add_argument("--all", action="store_true", help="remove the result limit while retaining path exclusions")


def root_path(raw: str) -> Path:
    try:
        path = Path(raw).expanduser().resolve()
        if path.is_dir():
            return path
    except (OSError, ValueError, RuntimeError):
        pass
    raise RgError("invalid_root", "Choose an existing, readable directory with --root.")


def interrupted(signum: int, frame: Any) -> None:
    raise KeyboardInterrupt


def main() -> int:
    parser = JsonParser(
        prog="codebase-search",
        description="Bounded, read-only codebase discovery and search. Defaults exclude generated and sensitive paths.",
    )
    sub = parser.add_subparsers(dest="command", required=True)
    files_parser = sub.add_parser("files", help="discover files")
    common(files_parser)
    search_parser = sub.add_parser("search", help="search file contents")
    search_parser.add_argument("pattern")
    common(search_parser)
    context_parser = sub.add_parser("context", help="search with surrounding lines")
    context_parser.add_argument("pattern")
    common(context_parser)
    context_parser.add_argument("--before", type=int, default=2)
    context_parser.add_argument("--after", type=int, default=2)
    metrics_parser = sub.add_parser("metrics", help="count bounded files, bytes, and lines")
    common(metrics_parser)
    args = parser.parse_args()
    if args.all and args.max_results is not None:
        parser.error("--all conflicts with an explicit --max-results bound")
    try:
        root = root_path(args.root)
        if args.max_results is not None and args.max_results < 1:
            raise ValueError("--max-results must be positive")
        limit = None if args.all else (DEFAULT_LIMIT if args.max_results is None else args.max_results)
        backend = RgBackend(root, SAFE_GLOBS)
        if args.command == "files":
            return emit(results.files(backend, limit))
        if args.command in ("search", "context"):
            before = args.before if args.command == "context" else 0
            after = args.after if args.command == "context" else 0
            if before < 0 or after < 0:
                raise ValueError("context values must not be negative")
            return emit(results.matches(backend, args.command, args.pattern, limit, before, after))
        return emit(results.metrics(backend, limit))
    except ValueError as exc:
        return emit({"status": "error", "error": "invalid_request", "message": str(exc)}, 2)
    except RgError as exc:
        if exc.diagnostics:
            sys.stderr.buffer.write(exc.diagnostics)
        return emit({"status": "error", "error": exc.code, "message": str(exc)}, 1)
    except KeyboardInterrupt:
        return emit({"status": "error", "error": "ripgrep_failed",
                     "message": "Scan interrupted; no complete results are available."}, 1)
    except OSError:
        return emit({"status": "error", "error": "ripgrep_failed",
                     "message": "Could not read the search inputs; check access and retry."}, 1)


if __name__ == "__main__":
    signal.signal(signal.SIGTERM, interrupted)
    raise SystemExit(main())
